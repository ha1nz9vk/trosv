{
  "max_function_length": 50,
  "max_complexity": 10,
  "max_nesting_depth": 4,
  "max_file_size_lines": 500,
  "min_duplicate_lines": 3,
  "ignore_patterns": [
    "*.pyc",
    "__pycache__",
    ".git",
    ".svn",
    "node_modules",
    "vendor",
    "storage",
    ".venv",
    "venv",
    ".agents",
    "build",
    "dist",
    "*.min.js",
    "*.map",
    "package-lock.json",
    "composer.lock",
    "*.lock",
    "*.svg",
    "*.png",
    "*.jpg",
    "*.jpeg",
    "*.ico",
    "*.woff*",
    "freebuff-chat-*",
    ".css-baseline",
    "css-selectors.json",
    "test-results",
    "playwright-report",
    ".system_generated",
    "coverage",
    ".phpunit.cache"
  ]
}
