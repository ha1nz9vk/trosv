# ============================================================
# TROSV - bien moi cho docker compose (copy thanh .env roi dien).
#
# Local dev: chi can APP_KEY + REVERB_* - cac gia tri con lai co mac
# dinh hop le cho localhost. Production: dien DAY DU cac muc co chu
# "production" ben duoi (DOMAIN, FRONTEND_URL, WS_HOST, DB_PASSWORD).
#
# Tao APP_KEY khong can PHP:
#   echo "APP_KEY=$(docker run --rm php:8.3-cli php -r 'echo "base64:".base64_encode(random_bytes(32));')" >> .env
#
# KHONG COMMIT file .env that. CI co job gitleaks quet moi push.
# ============================================================

# ----- Bat buoc -----
APP_KEY=
# REVERB_APP_* phai trung voi apps/api/.env (neu co) de WebSocket khop key.
REVERB_APP_ID=my-app-id
REVERB_APP_KEY=my-app-key
REVERB_APP_SECRET=my-app-secret

# ----- Production (HTTPS/Caddy) -----
# Domain co DNS A record tro ve server (khong the la IP - Let's Encrypt).
# Vi du: DOMAIN=trosv.example.com
# DOMAIN=
# FRONTEND_URL=https://trosv.example.com
# WS_HOST=trosv.example.com

# ----- Local dev (mac dinh da dung, khong can sua) -----
# FRONTEND_URL=http://localhost:5174
# WS_HOST=localhost

# ----- Tinh chinh (khong bat buoc) -----
# DB_PASSWORD=rental
# SEED_ON_BOOT=0            # 1 = chay db:seed khi boot (du lieu demo)
# FRONTEND_PORT=5174        # TLS mode: frontend khong can port nay
# API_PORT=8000             # TLS mode: backend khong publish ra host
# VITE_API_URL=/api         # same-origin; chi doi neu API o origin khac
# FRONTEND_EXTRA_URLS=      # origin khac cho CORS, phan tach bang dau phay

# ----- AI service (profile "ai", FAKE_MODE khong can key) -----
FAKE_MODE=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
