APP_NAME=TROSV
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# PRODUCTION (bắt buộc): APP_ENV=production, APP_DEBUG=false,
# APP_URL/FRONTEND_URL dùng HTTPS, SESSION_SECURE_COOKIE=true,
# và đặt DB/AI mật khẩu mạnh (không dùng rental/rental).
APP_URL=http://localhost:8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=rental
DB_USERNAME=rental
DB_PASSWORD=rental

FRONTEND_URL=http://localhost:5173
# Them origin khac (cach nhau bang dau phay) - vi du frontend docker :5174:
# FRONTEND_EXTRA_URLS=http://localhost:5174
AI_URL=http://localhost:8001

# Thoi han token dang nhap (phut) - mac dinh 30 ngay.
# SANCTUM_TOKEN_TTL_MINUTES=43200

# IP/CIDR cua reverse proxy tin tuong (vd: "*" hoac "10.0.0.0/8").
# De trong khi khong co proxy: header X-Forwarded-For se bi bo qua.
# BAT BUOC "*" khi chay profile TLS (backend chi nhan traffic tu Caddy).
# TRUSTED_PROXIES=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=my-app-id
REVERB_APP_KEY=my-app-key
REVERB_APP_SECRET=my-app-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
