# ============================================================
# TROSV - .env.production.example
#
# Copy to .env on the production host and fill in real values.
# Never commit the real .env. Every value here is a DEFAULT or
# PLACEHOLDER - secrets (APP_KEY, DB password, Reverb secret,
# LLM key) must be generated/rotated per environment.
# ============================================================

APP_NAME=TROSV
APP_ENV=production
# Fail-fast: the app refuses to serve when APP_DEBUG=true in production
# (bootstrap check - Phase 4). Never enable debug in production.
APP_DEBUG=false
APP_URL=https://trosv.example.com

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi

# 32-byte base64 key: php artisan key:generate
APP_KEY=

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ------------------------------------------------------------
# Logging: single_json = one JSON object per line for container
# log collectors (Docker json-file, journald, Loki, CloudWatch).
# request_id/user_id are attached to every line by AddRequestId.
# ------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single_json
LOG_LEVEL=info

# ------------------------------------------------------------
# Database (PostgreSQL). Use a strong password, NOT rental/rental.
# ------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=rental
DB_USERNAME=rental
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ------------------------------------------------------------
# Redis: queue, cache and session move off the `database` driver
# in production so workers scale independently and the DB is not
# the bottleneck. Requires a running Redis instance.
# Note: config defaults stay `database` for local dev - these env
# vars switch the drivers; nothing is hardcoded.
# ------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

# ------------------------------------------------------------
# CORS / frontend origins (no wildcards; supports_credentials
# stays false - Bearer-token auth, no cookies for the API).
# ------------------------------------------------------------
FRONTEND_URL=https://trosv.example.com
# Extra origins (comma-separated), e.g. a staging SPA or the
# dockerized frontend. Empty by default; no wildcard origins.
# FRONTEND_EXTRA_URLS=https://staging.trosv.example.com
FRONTEND_PREVIEW_URL=https://staging.trosv.example.com

# ------------------------------------------------------------
# AI service (internal). Backend returns a 503 fallback when it
# is unreachable, so the rest of the app keeps working.
# ------------------------------------------------------------
AI_URL=http://127.0.0.1:8001

# ------------------------------------------------------------
# Reverb (WebSockets). Production must use wss:// behind TLS.
# REVERB_APP_KEY is shared with the frontend (.env VITE_*).
# ------------------------------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=CHANGE_ME
REVERB_APP_KEY=CHANGE_ME
REVERB_APP_SECRET=CHANGE_ME
REVERB_HOST=trosv.example.com
REVERB_PORT=443
REVERB_SCHEME=https

# ------------------------------------------------------------
# Mail (verification/password reset if enabled later).
# ------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@trosv.example.com
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------
# Sanctum tokens (documented decision, docs/reports/PLAN.md): 30-day expiry.
# ------------------------------------------------------------
SANCTUM_EXPIRATION=2592000

# ------------------------------------------------------------
# Filesystem: private disk holds chat attachments (signed URLs);
# public disk holds listing images. On a VPS, point the roots at
# persistent volumes or switch to S3-compatible storage.
# ------------------------------------------------------------
FILESYSTEM_DISK=local
